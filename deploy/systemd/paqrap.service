[Unit]
Description=PaqRap backend
After=network.target

[Service]
User=paqrap
WorkingDirectory=/opt/paqrap
Environment=PAQRAP_DATA_DIR=/opt/paqrap/datos/reales
Environment=PAQRAP_PORT=8081
Environment=PAQRAP_BIND_ADDRESS=127.0.0.1
ExecStart=/usr/bin/java -Xmx1g -jar /opt/paqrap/paqrap.jar
Restart=on-failure
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
